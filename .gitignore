# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
**/dist/
/.wrangler/
/outputs/
/work/
/tmp/

# Firebase Hosting
/.firebase/
firebase-debug.log*
ui-debug.log*

# Unrelated local media; add intentionally if it becomes part of the app
/video/

# Secret-free, reproducible Stage 8 Function bundles and local validation logs
/build/tendermatch-stage8/
/build/tendermatch-stage9/
/build/stage9-*.log
/build/stage8-*.log
/build/tender-access-function/
/build/tender-access-release/
gha-creds-*.json
