{
  "hosting": {
    "target": "tender-apps",
    "public": "dist/tenderapps-production",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase*.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/landed-cost", "destination": "/__apps/logistics.html"},
      {"source": "/logistics-costing", "destination": "/__apps/logistics.html"},
      {"source": "/balance-sheet-review", "destination": "/__apps/balance.html"},
      {"source": "/tenderbalance", "destination": "/__apps/balance.html"},
      {"source": "/tendermatch", "destination": "/__apps/match.html"},
      {"source": "/tenderboost", "destination": "/__apps/match.html"},
      {"source": "/tenderboost-ai", "destination": "/__apps/match.html"},
      {"source": "/tendermatch/**", "destination": "/__apps/match.html"},
      {"source": "/tenderboost/**", "destination": "/__apps/match.html"},
      {"source": "/tenderboost-ai/**", "destination": "/__apps/match.html"},
      {"source": "**", "destination": "/index.html"}
    ],
    "headers": [
      {"source": "/assets/**", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
      {"source": "/**", "headers": [
        {"key": "Cache-Control", "value": "no-cache"},
        {"key": "Content-Security-Policy", "value": "default-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}
      ]}
    ]
  }
}
